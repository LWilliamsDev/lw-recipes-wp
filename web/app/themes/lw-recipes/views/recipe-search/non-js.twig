<div id="root" class="px-4 md:px-12">
		<div class="recipes-search mx-auto">
			<div class="form mt-8 md:mt-12">
				<form role="search" class="grid grid-cols-[1fr_40px] gap-x-2" id="recipe-search-form" method="GET">
					<label for="search" class="sr-only">{{__('Search', 'lw-recipes')}}</label>
					<input type="text" id="search" class="rounded-sm border border-(--color-mid-green) border-solid p-2" name="search" placeholder="{{__('Search Recipes...', 'lw-recipes')}}" value="{{ param_search }}">
					<button id="listing--search" class="button p-[10px] inline-block rounded-sm text-(--color-white) font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">{{__('Go', 'lw-recipes') }}</button>
				</form>
				{% if has_active_filters %}
					<div class="pt-5 flex flex-wrap gap-x-5 min-h-[56px]">
					</div>
				{% endif %}
			</div>
			<div class="results-container md:grid md:grid-cols-[0.5fr_2fr] md:gap-4">
				<div class="refiners mb-8 md:mb-0">
					{% for filter in filters %}
					{% if filter.terms %}
						<div class="refiner-fieldset mb-4">
						<fieldset>
							<legend class="sr-only">{{ __('Filter by %s', 'lw-recipes')|format(filter.name)}}</legend>
							<details class="tax-refiner">
          						<summary class="cursor-pointer text-(--color-mid-green) font-medium p-2 border-1 w-full rounded-t-sm md:border-0 md:rounded-t-none md:w-auto md:p-0">
            						{{ filter.name }}
          						</summary>
									{% for term in filter.terms %}
										<div class="refiner-checkbox">
											<input id="{{ term.taxonomy }}--{{ term.id }}" data-slug="{{ term.taxonomy }}" type="checkbox" value="{{ term.id }}" name="{{ term.taxonomy }}" form="recipe-search-form" {% if term.checked %} checked{% endif %}>
											<label for="{{ term.taxonomy }}--{{ term.id }}" class="pl-2 text-(--color-dark-green)">{{ term.name }}</label>
										</div>
									{% endfor %}
							</details>
						</fieldset>
					</div>
					{% endif %}
					{% endfor %}
				</div>
				<div class="results">
					{% if results %}
						{{ results }}
					{% endif %}
				</div>
				<div class="pagination md:col-start-2 pb-5">
					{% if pagination %}
						{{ pagination }}
					{% endif %}

				</div>
			</div>
		</div>
	</div>