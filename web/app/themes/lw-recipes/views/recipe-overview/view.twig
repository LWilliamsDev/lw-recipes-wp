<div class="mb-[10px] md:mb-[20px] pt-[5px] border-t border-solid border-(--color-mid-green)">
		{% if breadcrumbs %}
			<ul class="flex flex-wrap breadcrumbs gap-[10px]">
				{% for link in breadcrumbs %}
					{% if link.link and link.title %}
						<li>
							<a href="{{ link.link }}">{{ link.title}}</a>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		{% endif %}
	</div>
	<div class="mb-[20px]">
		<h1 class="font-roboto-condensed mb-[5px] text-3xl md:mb-[10px] md:text-5xl uppercase text-(--color-green)">{{ post.title }}</h1>
		{% if post.excerpt %}
			<p class="text-base md:text-2xl text-(--color-brown)">{{ post.excerpt({read_more: ''}) }}</p>
		{% endif %}
	</div>
	{% if post.thumbnail %}
		<div class="mb-[20px] md:mb-[30px]">
			 <img
					src="{{ post.thumbnail.src('full') }}"
            		alt="{{ post.thumbnail.alt }}"
            		class="w-full"
             >
		</div>
	{% endif %}
	{% if overviewData %}
		<ul class="flex flex-wrap gap-[10px] text-(--color-dark-green)">
			{% if overviewData.serves %}
				<li>
					<span class="text-(--color-brown)"><strong>Serves:</strong></span> {{ overviewData.serves }} 
				</li>
			{% endif %}
			{% if overviewData.prepTime %}
				<li>
					<span class="text-(--color-brown)"><strong>Prep Time:</strong></span> {{ overviewData.prepTime }}
					</li>
			{% endif %}
			{% if totalTime %}
				<li>
					<span class="text-(--color-brown)"><strong>Total Time:</strong></span> {{ overviewData.totalTime }}
				</li>
			{% endif %}
		</ul>
	{% endif %}