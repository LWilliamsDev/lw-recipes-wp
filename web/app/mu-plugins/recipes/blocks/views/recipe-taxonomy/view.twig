<section>
	<h2>{{ title }}</h2>
	<div>
		{% for term in terms %}
			<div>
				<h3>
					{% if term.link %}
						<a href="{{ term.link }}">
					{% else %}
						<span>
					{% endif %}
						{% if term.image %}
							<img
       	 						src="{{ term.image.src('full') }}"
        						alt="{{ term.image.alt }}"
    						>
						{% endif %}
						<div>
								{{ term.name }}</span>
						</div>
					{% if term.link %}
						</a>
					{% else %}
						</span>
					{% endif %}
				</h3>
			</div>
		{% endfor %}
	</div>
</section>