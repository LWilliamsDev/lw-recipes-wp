<nav class="pagination" aria-label="{{ __('Pagination', 'lw-recipes') }}">
    <ul class="pagination-numbers flex gap-2">

        {% if active_page > 1 %}
            <li>
                <a
                    href="?pg={{prev_page}}"
                    data-page="{{ prev_page }}"
                    class="filter-link cursor-pointer rounded-sm border-1 p-[5px] text-(--color-brown)">
                    {{ __('Back', 'lw-recipes') }}
                </a>
            </li>
        {% endif %}

        <li>
            <a
                href="?pg=1"
                data-page="1"
                class="filter-link{% if active_page == 1 %} current-page text-(--color-white){% else %} text-(--color-brown){% endif %} cursor-pointer rounded-sm border-1 p-[5px]"
                {% if active_page == 1 %}aria-current="page"{% endif %}>
                1
            </a>
        </li>

        {% if numbers and numbers|first > 2 %}
            <li class="p-[5px] text-(--color-mid-green)">
                <span>…</span>
            </li>
        {% endif %}

        {% for number in numbers %}
            <li>
                <a
                    href="?pg={{number}}"
                    data-page="{{ number }}"
                    class="filter-link{% if number == active_page %} current-page text-(--color-white){% else %} text-(--color-brown){% endif %} cursor-pointer rounded-sm border-1 p-[5px]"
                    {% if number == active_page %}aria-current="page"{% endif %}>
                    {{ number }}
                </a>
            </li>
        {% endfor %}

        {% if numbers and numbers|last < total_pages - 1 %}
            <li class="p-[5px] text-(--color-mid-green)">
                <span>…</span>
            </li>
        {% endif %}

        {% if total_pages > 1 %}
            <li>
                <a
                    href="?pg={{total_pages }}"
                    data-page="{{ total_pages }}"
                    class="filter-link{% if active_page == total_pages %} current-page text-(--color-white){% else %} text-(--color-brown){% endif %} cursor-pointer rounded-sm border-1 p-[5px]"
                    {% if active_page == total_pages %}aria-current="page"{% endif %}>
                    {{ total_pages }}
                </a>
            </li>
        {% endif %}

        {% if active_page < total_pages %}
            <li>
                <a
                    href="?pg={{next_page}}"
                    data-page="{{ next_page }}"
                    class="filter-link cursor-pointer rounded-sm border-1 p-[5px] text-(--color-brown)">
                    {{ __('Next', 'lw-recipes') }}
                </a>
            </li>
        {% endif %}

    </ul>
</nav>