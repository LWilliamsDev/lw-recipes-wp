<div id="root">
		<div>
			<div>
				<form role="search" id="recipe-search-form" method="GET">
					<label for="search" class="sr-only">{{__('Search', 'lw-recipes')}}</label>
					<input type="text" id="search" name="search" placeholder="{{__('Search Recipes...', 'lw-recipes')}}" value="{{ param_search }}">
					<button id="listing--search">{{__('Go', 'lw-recipes') }}</button>
				</form>
				{% if has_active_filters %}
					<div>
					</div>
				{% endif %}
			</div>
			<div>
				<div>
					{% for filter in filters %}
					{% if filter.terms %}
						<div>
						<fieldset>
							<legend>{{ __('Filter by %s', 'lw-recipes')|format(filter.name)}}</legend>
							<details class="tax-refiner">
          						<summary>
            						{{ filter.name }}
          						</summary>
									{% for term in filter.terms %}
										<div class="refiner-checkbox">
											<input id="{{ term.taxonomy }}--{{ term.id }}" data-slug="{{ term.taxonomy }}" type="checkbox" value="{{ term.id }}" name="{{ term.taxonomy }}" form="recipe-search-form" {% if term.checked %} checked{% endif %}>
											<label for="{{ term.taxonomy }}--{{ term.id }}" class="pl-2 text-(--color-dark-green)">{{ term.name }}</label>
										</div>
									{% endfor %}
							</details>
						</fieldset>
					</div>
					{% endif %}
					{% endfor %}
				</div>
				<div>
					{% if results %}
						{{ results }}
					{% endif %}
				</div>
				<div>
					{% if pagination %}
						{{ pagination }}
					{% endif %}

				</div>
			</div>
		</div>
	</div>