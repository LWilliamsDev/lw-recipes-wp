<section>
			<h2>
				{{ title }}
			</h2>

			{% if posts %}
				<div>
				{% for post in posts %}
				<div>
				    {% if post.thumbnail %}
				    	<a href="{{post.link}}">
				    		 <img
						 		src="{{ post.thumbnail.src('full') }}"
            					alt="{{ post.thumbnail.alt }}"
            				  >
				    	</a>
				    {% endif %}
					<h3>{{ post.title }}</a></h3>
					{% if post.excerpt %}
						<p>{{ post.excerpt }}</p>
					{% endif %}
					{% if post.diet %}
					<ul>
						{% for term in post.diet %}
						{% if term.link %}
							<li><a href="{{ term.link }}?diet={{ term.id }}">{{ term.name }}</a></li>
						{% else %}
							<li><span>{{ term.name }}</span></li>
						{% endif %}
					{% endfor %}
					</ul>
				{% endif %}
				</div>
			{% endfor %}
			</div>
			{% endif %}
			
		</section>
