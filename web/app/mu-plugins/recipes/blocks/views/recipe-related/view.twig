	{% if posts %}
		<aside>
			<div>
				<h2>{{__('You Might Also Like', 'lw-recipes') }}</h2>
				<ul>
					{% for post in posts %}
						<li>
						<a href="{{ post.link }}">
							{% if post.thumbnail %}
								<img
						 			src="{{ post.thumbnail.src('full') }}"
            						alt="{{ post.thumbnail.alt }}"
            				  	>
							{% endif %}
							<h3>{{ post.title }}</h3>
						</a>
					</li>
					{% endfor %}
				</ul>
			</div>
		</aside>
	{% endif %}