	<header>
		<div<a href="/">{{__('Home', 'lw-recipes')}}</a></div>
		<div class="md:hidden flex items-center justify-end">
			<button aria-label="{{__('Toggle mobile menu', 'lw-recipes')}}" id="toggle-mobile-menu" aria-controls="primary-nav" aria-expanded="false">
			</button>
			<button aria-label="{{__('Toggle search', 'lw-recipes')}}" id="search-btn-mobile" aria-controls="search-form" aria-expanded="false">
			</button>
		</div>
		<div id="search-form">
			<form>
				<div>
					<input type="text" key="search" placeholder="{{__('Search...', 'lw-recipes')}}" class="rounded-sm border border-(--color-mid-green) border-solid p-2" id="search-input" />
					<button type="submit" id="search-submit">{{__('Go', 'lw-recipes')}}</button>
				</div>
			</form>
		</div>
		<div>
				<nav>
					<ul id="primary-nav">
						{% for item in menu.items %}
							<li>
								<a href="{{item.link}}" {{ item.is_target_blank ? 'target="_blank"' }}>{{ item.title }}</a>

								{% if item.children %}
									<button aria-label="{{ __('Expand or collapse the %s submenu', 'lw-recipes')|format(item.title)}}" id="{{item.id}}-toggle" aria-controls="menu-item-{{item.id}}-submenu" aria-expanded="false">
									</button>
									<ul id="menu-item-{{item.id}}-submenu">
										{% for child in item.children %}
											<li>
												<a href="{{child.link}}" {{ child.is_target_blank ? 'target="_blank"' }}>{{ child.title }}</a>
											</li>
										{% endfor %}
									</ul>

								{% endif %}
							</li>
						{% endfor %}
					</ul>
				</nav>
			<button aria-label="{__('Toggle search' ,'lw-recipes')}}" id="search-btn-desktop" aria-controls="search-form" aria-expanded="false">
			</button>
		</div>
	</header>