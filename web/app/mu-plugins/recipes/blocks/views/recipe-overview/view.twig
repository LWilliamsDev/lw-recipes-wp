<div>
		{% if breadcrumbs %}
			<ul>
				{% for link in breadcrumbs %}
					{% if link.link and link.title %}
						<li>
							<a href="{{ link.link }}">{{ link.title}}</a>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		{% endif %}
	</div>
	<div>
		<h1>{{ post.title }}</h1>
		{% if post.excerpt %}
			<p>{{ post.excerpt }}</p>
		{% endif %}
	</div>
	{% if post.thumbnail %}
		<div>
			 <img
					src="{{ post.thumbnail.src('full') }}"
            		alt="{{ post.thumbnail.alt }}"
             >
		</div>
	{% endif %}
	{% if overviewData %}
		<ul>
			{% if overviewData.serves %}
				<li>
					<span><strong>Serves:</strong></span> {{ overviewData.serves }} 
				</li>
			{% endif %}
			{% if overviewData.prepTime %}
				<li>
					<span><strong>Prep Time:</strong></span> {{ overviewData.prepTime }}
					</li>
			{% endif %}
			{% if totalTime %}
				<li>
					<span><strong>Total Time:</strong></span> {{ overviewData.totalTime }}
				</li>
			{% endif %}
		</ul>
	{% endif %}