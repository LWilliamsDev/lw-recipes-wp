{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lw-recipes/page-template",
  "version": "0.1.0",
  "title": "Page Template",
  "category": "theme",
  "icon": "smiley",
