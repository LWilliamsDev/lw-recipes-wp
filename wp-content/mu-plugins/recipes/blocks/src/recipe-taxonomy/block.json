{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lw-recipes/recipe-taxonomy",
	"version": "0.1.0",
	"title": "Recipe Taxonomy",
	"category": "theme",
	"icon": "list-view",
	"description": "Display all terms of the selected taxonomy for the recipe post type",
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"title" : {
			"type": "string"
		},
		"taxonomy" : {
			"type": "string",
			"default": "diet"
		}

	},
	"textdomain": "lw-recipes",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
