{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lw-recipes/recipe-overview",
	"version": "0.1.0",
	"title": "Recipe Overview",
	"category": "theme",
	"icon": "smiley",
	"description": "Display a recipe overview",
	"example": {},
	"attributes": {
		"serves" : {
			"type": "string"
		},
		"prepTime" : {
			"type": "string"
		},
		"totalTime" : {
			"type": "string"
		}
