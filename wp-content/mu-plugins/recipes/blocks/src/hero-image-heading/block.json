{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lw-recipes/hero-image-heading",
	"parent": ["lw-recipes/hero-image"],
	"version": "0.1.0",
	"title": "Hero Image Heading",
	"category": "theme",
	"icon": "smiley",
	"description": "Display a hero image",
	"example": {},
	"supports": {
		"html": false,
		"layout": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"source" : "html",
			"selector": "h1, h2, h3, h4, h5, h6",
			"default" : "My Hero Title"
		},
		"headingLevel" : {
			"type": "number",
			"default" : 1
		}
	},
	"textdomain": "lw-recipes",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
